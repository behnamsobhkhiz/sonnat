{
  "name": "sonnat-web",
  "version": "0.0.0",
  "private": true,
  "description": "SONNAT Web — the React implementation of Divar's SONNAT design system.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "build": "pnpm --filter \"./packages/*\" -r build",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@behnamsobhkhiz/sonnat-tokens": "workspace:*",
    "@changesets/cli": "2.27.10",
    "@eslint/js": "9.17.0",
    "@storybook/addon-essentials": "8.4.7",
    "@storybook/addon-themes": "8.4.7",
    "@storybook/react": "8.4.7",
    "@storybook/react-vite": "8.4.7",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.13.0",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "8.4.7",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11"
  }
}
