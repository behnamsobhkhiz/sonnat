# Route the @behnamsobhkhiz scope to GitHub Packages (publish target).
# Workspace packages resolve locally; this only matters at publish time (Phase 1).
# Auth is injected by CI (setup-node + NODE_AUTH_TOKEN) — never committed here.
@behnamsobhkhiz:registry=https://npm.pkg.github.com

# Keep installs deterministic and forgiving of transitive peer ranges.
auto-install-peers=true
strict-peer-dependencies=false
